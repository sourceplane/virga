{
  "name": "@site/web-site-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@site/eslint-config": "workspace:*",
    "@site/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@site/contracts": "workspace:*",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@site/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^@site/contracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1.ts",
      "^@web-site/(.*)$": "<rootDir>/../../apps/web-site/src/$1.ts"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "useESM": true, "diagnostics": false }]
    },
    "testMatch": ["<rootDir>/src/**/*.test.ts"]
  }
}
