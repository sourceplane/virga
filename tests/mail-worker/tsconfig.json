{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "types": ["jest", "node", "@cloudflare/workers-types"],
    "allowSyntheticDefaultImports": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@site/contracts": ["../../packages/contracts/src/index.ts"],
      "@site/contracts/*": ["../../packages/contracts/src/*.ts"],
      "@site/shared": ["../../packages/shared/src/index.ts"],
      "@site/shared/*": ["../../packages/shared/src/*.ts"],
      "@site/db": ["../../packages/db/src/index.ts"],
      "@site/db/cursor": ["../../packages/db/src/cursor.ts"],
      "@site/db/json": ["../../packages/db/src/json.ts"],
      "@site/db/*": ["../../packages/db/src/*/index.ts"],
      "@site/testing": ["../../packages/testing/src/index.ts"],
      "@site/testing/*": ["../../packages/testing/src/*.ts"],
      "@mail-worker/*": ["../../apps/mail-worker/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../apps/mail-worker/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
